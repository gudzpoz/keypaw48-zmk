#include <dt-bindings/zmk/rgb.h>

/ {
    // Indicators composited over the active effect, declared once here and
    // referenced from each half's &rgb_matrix node (see the overlays). They are
    // deliberately NOT children of &kprgb: those are the effect registry, whose
    // `index` must equal the child position.
    rgb_indicators {
        // Placeholder target: point this at whatever key you bind Caps to. The
        // default keymap has no Caps binding, so this stays dark until then.
        caps: caps {
            compatible = "keypaw,rgb-indicator-caps-lock";
            keys = <30>;
            color = <0x00FF00>;
        };

        // One node per layer that should show on its own LED.
        layer_fn: layer_fn {
            compatible = "keypaw,rgb-indicator-layer";
            layer = <1>;      // the Fn layer
            keys = <35>;      // the key bound to &mo 1
            color = <0xFF8000>;
        };
    };

    // Condition -> command rules, evaluated on the central and pushed to both
    // halves. The table's children are the triggers, and their DECLARATION
    // ORDER is the precedence order: the first one whose condition is active
    // wins.
    //
    // There is deliberately no `triggers = <...>;` list here: every devicetree
    // node depends on its parent, so a parent pointing at its own child is a
    // phandle cycle. And these nodes are NOT children of &kprgb, whose children
    // are the effect registry (an effect's `index` must equal the child
    // position) -- besides which the bindings below reference &kprgb back.
    rgb_triggers {
        compatible = "keypaw,rgb-trigger-table";

        // Catch-all: fires when nothing earlier matched. Must be declared LAST;
        // nothing enforces that. Bound to index 0 (fx_solid), which is what
        // `initial-effect` already selects, so the default look is unchanged.
        trig_default: trig_default {
            compatible = "keypaw,rgb-trigger-always";
            bindings = <&kprgb RGB_EFS_CMD 0>;
        };

        // Example: switch to fx_fn_orange while the Fn layer is held. To enable,
        // uncomment this node and DECLARE IT ABOVE trig_default:
        //
        // trig_fn: trig_fn {
        //     compatible = "keypaw,rgb-trigger-layer";
        //     layer = <1>;
        //     bindings = <&kprgb RGB_EFS_CMD 7>;
        // };
    };

    behaviors {
        // Behavior can be invoked on peripherals, so name must be <= 8 characters.
        kprgb: kprgb {
            compatible = "keypaw,behavior-rgb-matrix";
            #binding-cells = <2>;
            display-name = "RGB Matrix";

            max-brightness = <40>;
            idle-brightness = <30>;
            initial-brightness = <30>;
            initial-effect = <0>;
            initial-on;

            // Both `index` and the declaration order matter: an effect's index
            // must equal its position among these children (they travel the
            // split link as a single byte).
            fx_solid: fx_solid {
                compatible = "keypaw,rgb-matrix-solid";
                #binding-cells = <0>;
                index = <0>;
                color = <0xFF0000>;
                // Per-effect override: only the Caps LED is composited here.
                indicators = <&caps>;
            };
            fx_breathe: fx_breathe {
                compatible = "keypaw,rgb-matrix-breathe";
                #binding-cells = <0>;
                index = <1>;
                color = <0x0000FF>;
                duration = <2400>;
            };
            fx_spectrum: fx_spectrum {
                compatible = "keypaw,rgb-matrix-spectrum";
                #binding-cells = <0>;
                index = <2>;
                duration = <4000>;
            };
            fx_swirl: fx_swirl {
                compatible = "keypaw,rgb-matrix-swirl";
                #binding-cells = <0>;
                index = <3>;
                color = <0x00FF00>;
                duration = <3000>;
            };
            fx_reactive: fx_reactive {
                compatible = "keypaw,rgb-matrix-reactive";
                #binding-cells = <0>;
                index = <4>;
                color = <0xFFFFFF>;
                duration = <500>;
                background-brightness = <10>;
            };
            fx_ripple: fx_ripple {
                compatible = "keypaw,rgb-matrix-ripple";
                #binding-cells = <0>;
                index = <5>;
                color = <0x00FFFF>;
                duration = <2000>;
                background-brightness = <10>;
                // Radial ripples own the whole half: keep the canvas clean.
                no-indicators;
            };
            /* Example custom effect from the separate zmk-rgb-effect-example
             * module -- proves a new effect can be added without editing
             * zmk-behavior-rgb-matrix. */
            fx_example: fx_example {
                compatible = "keypaw,rgb-matrix-example";
                #binding-cells = <0>;
                index = <6>;
                color = <0x00FFAA>;
                duration = <3000>;
                tail-length = <200>;
            };
            /* Layer variant, reached only through the &trig_fn example above.
             * `no-cycle` keeps it out of RGB_EFF/EFR so it does not clutter the
             * normal cycle; RGB_EFS 7 and a trigger can still select it. */
            fx_fn_orange: fx_fn_orange {
                compatible = "keypaw,rgb-matrix-solid";
                #binding-cells = <0>;
                index = <7>;
                color = <0xFF8000>;
                no-cycle;
            };
        };
    };
};
