#include <dt-bindings/zmk/rgb.h>

/ {
    // Overlays are listed on each behavior in paint order. They remain
    // outside &kprgb because its children are the effect registry; this shared
    // list is referenced by the behavior below.
    //
    // The compatible makes this the engine's overlay registry: children are
    // enumerated in declaration order and that index is the bit the central
    // uses to push each overlay's on/off state to the peripheral.
    rgb_overlays: rgb_overlays {
        compatible = "keypaw,rgb-overlays";
        // Placeholder target: point this at whatever key you bind Caps to. The
        // default keymap has no Caps binding, so this stays dark until then.
        caps: caps {
            compatible = "keypaw,rgb-overlay-caps-lock";
            keys = <41>;
            color = <0x00FFFF>;
        };

        // Lights while &dm is recording. Keys have to be on the central half.
        // The recorder exists only there, so the central evaluates and pushes
        // the state instead of each half reading the getter.
        dm_rec: dm_rec {
            compatible = "keypaw,rgb-overlay-dynamic-macro";
            central-authoritative;
            keys = <11 23 35>;
            color = <0xFF0000>;
        };

        // Layer overlays are defined in keypaw48.keymap.
    };

    // Condition -> command rules, evaluated on the central and pushed to both
    // halves. The table's children are the triggers, and their DECLARATION
    // ORDER is the precedence order: the first one whose condition is active
    // wins.
    //
    // There is deliberately no `triggers = <...>;` list here: every devicetree
    // node depends on its parent, so a parent pointing at its own child is a
    // phandle cycle. And these nodes are NOT children of &kprgb, whose children
    // are the effect registry (an effect is identified by its position there)
    // -- besides which the bindings below reference &kprgb back.
    rgb_triggers: rgb_triggers {
        compatible = "keypaw,rgb-trigger-table";
        // The actual triggers are defined in keypaw48.keymap.
    };

    // A multi-zone setup can declare another sibling behavior with its own
    // effect registry. Keep each behavior name <= 8 characters for split:
    //
    // rgb_main: rgb_main {
    //     compatible = "keypaw,behavior-rgb-matrix";
    //     #binding-cells = <2>;
    //     leds = <0 1 2 3 4 5 6 7>;
    //     fx_main: fx_main {
    //         compatible = "keypaw,rgb-matrix-solid";
    //         #binding-cells = <0>;
    //     };
    // };
    // rgb_num: rgb_num {
    //     compatible = "keypaw,behavior-rgb-matrix";
    //     #binding-cells = <2>;
    //     leds = <8 9 10 11 12 13 14 15>;
    //     fx_num: fx_num {
    //         compatible = "keypaw,rgb-matrix-solid";
    //         #binding-cells = <0>;
    //     };
    // };

    behaviors {
        // Behavior can be invoked on peripherals, so name must be <= 8 characters.
        kprgb: kprgb {
            compatible = "keypaw,behavior-rgb-matrix";
            #binding-cells = <2>;
            display-name = "RGB Matrix";

            max-brightness = <40>;
            idle-brightness = <30>;
            initial-brightness = <30>;
            initial-effect = <0>;
            initial-on;
            overlays = <&caps &dm_rec &layer_sym &layer_fun &layer_pad &layer_fn2>;

            // Declaration order is the identity: an effect's position among
            // these children is the slot that travels the split link as a
            // single byte.
            fx_solid: fx_solid {
                compatible = "keypaw,rgb-matrix-solid";
                #binding-cells = <0>;
                color = <0xFF0000>;
                // Per-effect override: only the Caps LED and the dynamic-macro
                // recording LED are composited here. fx_solid is initial-effect,
                // so dm_rec must be listed or recording feedback would be dark
                // at boot.
                overlays = <&caps &dm_rec>;
            };
            fx_breathe: fx_breathe {
                compatible = "keypaw,rgb-matrix-breathe";
                #binding-cells = <0>;
                color = <0x0000FF>;
                duration = <2400>;
            };
            fx_spectrum: fx_spectrum {
                compatible = "keypaw,rgb-matrix-spectrum";
                #binding-cells = <0>;
                duration = <4000>;
            };
            fx_reactive: fx_reactive {
                compatible = "keypaw,rgb-matrix-reactive";
                #binding-cells = <0>;
                color = <0xFFFFFF>;
                duration = <500>;
                background-brightness = <10>;
            };
            fx_ripple: fx_ripple {
                compatible = "keypaw,rgb-matrix-ripple";
                #binding-cells = <0>;
                color = <0x00FFFF>;
                duration = <2000>;
                background-brightness = <10>;
                // Radial ripples own the whole half: keep the canvas clean.
                no-overlays;
            };
            /* Example custom effect from the separate zmk-rgb-effect-example
             * module -- proves a new effect can be added without editing
             * zmk-rgb-matrix. */
            fx_example: fx_example {
                compatible = "keypaw,rgb-matrix-example";
                #binding-cells = <0>;
                color = <0x00FFAA>;
                duration = <3000>;
                tail-length = <200>;
            };
            /* Layer variant, reached only through the &trig_fn example above.
             * `no-cycle` keeps it out of RGB_EFF/EFR so it does not clutter the
             * normal cycle; RGB_EFS 7 and a trigger can still select it. */
            fx_fn_orange: fx_fn_orange {
                compatible = "keypaw,rgb-matrix-solid";
                #binding-cells = <0>;
                color = <0xFF8000>;
                no-cycle;
            };

            /* Moving spatial fields share compatible families; attributes pick
             * the sub-effect. Instantiate more nodes for extra cycle entries. */
            fx_rainbow: fx_rainbow {
                compatible = "keypaw,rgb-matrix-rainbow";
                #binding-cells = <0>;
                color = <0xFFFFFF>;
                duration = <4000>;
                basis = "x";
                direction = "out";
                palette = "rainbow";
            };
            fx_band: fx_band {
                compatible = "keypaw,rgb-matrix-band";
                #binding-cells = <0>;
                color = <0x00FF00>;
                duration = <3000>;
                channel = "sat";
                shape = "linear";
            };
            fx_static: fx_static {
                compatible = "keypaw,rgb-matrix-static";
                #binding-cells = <0>;
                color = <0xFFFFFF>;
                /* Per-LED colours indexed by strip chain position (left half has
                 * 30 LEDs). A stand-in for QMK ALPHAS_MODS: alternate hues to
                 * show per-key control. Edit to taste. */
                led-colors = <
                    0x0000FF 0x0000FF 0x0000FF 0x0000FF 0x0000FF 0x0000FF
                    0xFF0000 0xFF0000 0xFF0000 0xFF0000 0xFF0000 0xFF0000
                    0x0000FF 0x0000FF 0x0000FF 0x0000FF 0x0000FF 0x0000FF
                    0xFF0000 0xFF0000 0xFF0000 0xFF0000 0xFF0000 0xFF0000
                    0x00FF00 0x00FF00 0x00FF00 0x00FF00 0x00FF00 0x00FF00
                >;
            };

            /* Stochastic fields share compatible families; attributes pick the
             * sub-effect. Instantiate more nodes for extra cycle entries. */
            fx_rain: fx_rain {
                compatible = "keypaw,rgb-matrix-rain";
                #binding-cells = <0>;
                color = <0x0080FF>;
                duration = <4000>;
                mode = "drops";
            };
            fx_starlight: fx_starlight {
                compatible = "keypaw,rgb-matrix-starlight";
                #binding-cells = <0>;
                color = <0xFFFFFF>;
                duration = <4000>;
                smooth;
                dual-hue;
                dual-sat;
            };
            fx_heatmap: fx_heatmap {
                compatible = "keypaw,rgb-matrix-heatmap";
                #binding-cells = <0>;
                color = <0xFFFFFF>;
                decrease-delay-ms = <25>;
                spread = <150>;
                area-limit = <16>;
                increase-step = <32>;
            };
            fx_digital_rain: fx_digital_rain {
                compatible = "keypaw,rgb-matrix-digital-rain";
                #binding-cells = <0>;
                color = <0x00FF00>;
                duration = <4000>;
            };
            /* QMK FLAG: a left-right rainbow skewed per row, so the bands
             * undulate like a waving flag. */
            fx_flag: fx_flag {
                compatible = "keypaw,rgb-matrix-rainbow";
                #binding-cells = <0>;
                color = <0xFFFFFF>;
                duration = <4000>;
                basis = "flag";
                palette = "rainbow";
            };
            /* QMK COMPLEMENT: the preset hue on the dim background, with a
             * pressed key flashing the opposite hue. */
            fx_complement: fx_complement {
                compatible = "keypaw,rgb-matrix-reactive";
                #binding-cells = <0>;
                color = <0xFF0000>;
                duration = <500>;
                spread = "point";
                background-brightness = <10>;
                palette = "complement";
            };
        };
    };
};
