#include <input/processors.dtsi>
#include <dt-bindings/keypaw/rgb_matrix.h>

#include "keypaw48.dtsi"
#include "kp-peri_right.dtsi"

&default_transform {
    col-offset = <6>;
};

/ {
    rgb_matrix: rgb-matrix {
        compatible = "keypaw,rgb-matrix";
        strip = <&led_strip>;
        physical-layout = <&default_layout>;

        mapping = <
        6 7 8 9 10 11
        23 22 21 20 19 18
        30 31 32 33 34 35

        KP_RGB_NO_KEY(1450, 387) // between 35 & 47
        KP_RGB_NO_KEY(1350, 387) // between 34 & 46
        KP_RGB_NO_KEY(1250, 400) // ~to the left of the previous LED
        KP_RGB_NO_KEY(1180, 350) // ~to the top left of the previous LED
        47 46
        KP_RGB_NO_KEY(1000, 500) // ~to the right of 42
        42
        KP_RGB_NO_KEY(850, 475)  // ~to the left of 42
        43 44 45
        >;
    };

    glidepoint_listener {
        compatible = "zmk,input-listener";
        device = <&paw3395>;
        glidepoint_scroller: glidepoint_scroller {
            // layers = specified in keypaw48.keymap;
            input-processors = <&zip_xy_to_scroll_mapper>;
        };
    };

    ft6236_listener: ft6236_listener {
        compatible = "zmk,input-listener";
        device = <&ft6236_split>;

        /* Scroll tuning: param1 = X, param2 = Y, in raw panel pixels per wheel
         * notch (0 -> 1), lower is faster. This panel is ~195 px/inch, so 36 is
         * ~5.4 notches per inch. The processor logs pixels vs notches per touch.
         *
         * Gesture dispatch comes first: it consumes the codes it maps and stops
         * the chain, so the scroll processor never sees a gesture. */
        input-processors = <&ft6236_gestures &ft6236_scroll 36 36>;
    };

    /* Single-finger scroll for the FT6236's single-touch frames. */
    ft6236_scroll: ft6236_scroll {
        compatible = "zmk,input-processor-ft6236-scroll";
        #input-processor-cells = <2>;
        scroll-natural;
    };
};
