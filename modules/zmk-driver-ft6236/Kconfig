# FT6236 capacitive touch panel driver

config FT6236
        bool "FT6236 capacitive touch panel driver"
        default y
        depends on DT_HAS_FOCALTECH_FT6236_ENABLED
        select I2C
        select GPIO
        select INPUT
        select INPUT_TOUCH
        help
          Enable driver for the FocalTech FT6236/FT6x36 family self-capacitive
          touch controllers. Classifies gestures in firmware from the contact
          geometry and emits one key event per gesture, held from recognition
          until the contact lifts, for the central half to map onto behaviours.

module = FT6236
module-str = FT6236
source "${ZEPHYR_BASE}/subsys/logging/Kconfig.template.log_config"
