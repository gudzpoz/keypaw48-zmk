# FT6236 capacitive touch panel driver + single-finger scroll input processor

config FT6236
        bool "FT6236 capacitive touch panel driver"
        default y
        depends on DT_HAS_FOCALTECH_FT6236_ENABLED
        select I2C
        select GPIO
        select INPUT
        select INPUT_TOUCH
        help
          Enable driver for the FocalTech FT6236/FT6x36 family self-capacitive
          touch controllers. Reports the first touch point as a single-touch
          input frame and decodes the controller's on-chip gesture engine into
          one key event per gesture, for the central half to map onto
          behaviours.

if FT6236

config FT6236_REPORT_PERIOD_MS
        int "Minimum interval between emitted movement frames (ms)"
        default 33
        help
          Minimum spacing between emitted frames. Press/lift transitions are
          always emitted immediately regardless of this setting; only pure
          movement frames are throttled. Because each event rides the split
          link as a separate BLE notification, this throttle keeps the
          peripheral->central link healthy. Lower values increase touchpad
          smoothness at the cost of BLE bandwidth.

endif # FT6236

config FT6236_SCROLL
        bool "FT6236 single-finger scroll input processor"
        default y
        depends on DT_HAS_ZMK_INPUT_PROCESSOR_FT6236_SCROLL_ENABLED
        select INPUT
        help
          Convert the FT6236's single-touch coordinates into relative scroll
          wheel events on the mouse interface. Runs on the split central, where
          the input-processor node lives, and is enabled automatically when
          that node is present in the devicetree. Pair with
          ZMK_POINTING_SMOOTH_SCROLLING so scroll is emitted in 1/16-notch
          subunits for hosts that support HID Resolution Multipliers.

# Shared by the driver (peripheral) and the scroll processor (central), which
# live under different Kconfig gates: FT6236 is off on the central, where the
# panel node does not exist, and FT6236_SCROLL is off on the peripheral. This
# block must therefore stay outside both `if` blocks.
module = FT6236
module-str = FT6236
source "${ZEPHYR_BASE}/subsys/logging/Kconfig.template.log_config"
