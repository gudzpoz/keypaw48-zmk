# JD9613 display controller configuration options

config JD9613
    bool "JD9613 compatible display controller driver"
    default y
    depends on DT_HAS_JADARD_JD9613_ENABLED
    select SPI
    select DISPLAY
    help
        Enable driver for the Jadard JD9613 LTPS AMOLED controller.

###############
# RGB Support #
###############

config LV_Z_BITS_PER_PIXEL
    default 24

config ZMK_DISPLAY_INVERT
    default y

config ZMK_DISPLAY_BLANK_ON_IDLE
    default y

config ZMK_DISPLAY
    select LV_USE_THEME_MONO

#################
# Area Rounding #
#################

# The JD9613 requires write regions with even coordinates (see
# jd9613_set_window in the driver). Point the LVGL glue's built-in rounder
# at a 2x2 alignment instead of carrying LVGL-specific code in the driver;
# a non-1 alignment auto-enables LV_Z_USE_ROUNDER_CB.
config LV_Z_AREA_X_ALIGNMENT_WIDTH
    default 2 if DT_HAS_JADARD_JD9613_ENABLED

config LV_Z_AREA_Y_ALIGNMENT_WIDTH
    default 2 if DT_HAS_JADARD_JD9613_ENABLED

##############
# Work Queue #
##############

# The driver defers controller init to the first blanking off and sleeps
# 120ms after SLPOUT on every unblank. Run display init/blanking and LVGL
# rendering on a dedicated queue so those waits never stall the system
# workqueue (keyscan, BLE, event processing).
choice ZMK_DISPLAY_WORK_QUEUE
    default ZMK_DISPLAY_WORK_QUEUE_DEDICATED if DT_HAS_JADARD_JD9613_ENABLED
endchoice

##############
# Higher DPI #
##############

choice LV_FONT_DEFAULT
    default LV_FONT_DEFAULT_MONTSERRAT_28
endchoice

choice ZMK_LV_FONT_DEFAULT_SMALL
    default ZMK_LV_FONT_DEFAULT_SMALL_MONTSERRAT_20
endchoice

# LVGL requires a larger memory pool for higher DPI.
# Otherwise, the widgets might draw some random noise due to allocation failure.
config LV_Z_MEM_POOL_SIZE
    default 65536

########################
# Custom Status Screen #
########################

choice ZMK_DISPLAY_STATUS_SCREEN
    default ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
endchoice

config ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
    imply ZMK_WIDGET_ANIMATION
    imply ZMK_WIDGET_RGB_BATTERY_STATUS
    imply ZMK_WIDGET_RGB_OUTPUT_STATUS
    imply ZMK_WIDGET_RGB_PERIPHERAL_STATUS
    imply ZMK_WIDGET_RGB_LAYER_STATUS
    imply ZMK_WIDGET_RGB_WPM_STATUS

config ZMK_WIDGET_BAD_APPLE
    bool "Bad Apple playback widget for keypaw48"
    select LV_USE_CANVAS

config ZMK_WIDGET_ANIMATION
    bool "Animation widget for keypaw48"
    select LV_USE_ANIMIMG
    select ZMK_WIDGET_RGB_ICONS
    help
        Plays one of the GIF animations converted by scripts/gen_icons.py.
        Which one is selected by ZMK_WIDGET_ANIMATION_SOURCE, a Kconfig
        choice generated into src/widgets/icons/Kconfig.animations by
        `make resources`.

# The choice is generated alongside the icons, which are not checked in (see
# .gitignore), so it has to be sourced optionally.
orsource "src/widgets/icons/Kconfig.animations"

###############
# RGB Widgets #
###############

config ZMK_WIDGET_RGB_ICONS
    bool
    # Implied by any widget that uses icon images
    select LV_BIN_DECODER_RAM_LOAD
    select LV_USE_RLE

config ZMK_WIDGET_ANIMATION_DURATION
    int "Animation single loop duration in ms for the animation widget."
    default 1500

config ZMK_WIDGET_RGB_BATTERY_STATUS
    bool "RGB battery status widget"
    depends on ZMK_BATTERY_REPORTING
    select LV_USE_FLEX
    select LV_USE_IMAGE
    select LV_USE_LABEL
    select ZMK_WIDGET_RGB_ICONS

config ZMK_WIDGET_RGB_OUTPUT_STATUS
    bool "RGB output status widget"
    depends on !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL
    select LV_USE_FLEX
    select LV_USE_IMAGE
    select LV_USE_LABEL
    select ZMK_WIDGET_RGB_ICONS

config ZMK_WIDGET_RGB_PERIPHERAL_STATUS
    bool "RGB peripheral status widget"
    depends on BT && ZMK_SPLIT_BLE && !ZMK_SPLIT_ROLE_CENTRAL
    select LV_USE_IMAGE
    select ZMK_WIDGET_RGB_ICONS

config ZMK_WIDGET_RGB_LAYER_STATUS
    bool "RGB layer status widget"
    depends on !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL
    select LV_USE_FLEX
    select LV_USE_IMAGE
    select LV_USE_LABEL
    select ZMK_HID_INDICATORS
    select ZMK_WIDGET_RGB_ICONS

config ZMK_WIDGET_RGB_WPM_STATUS
    bool "RGB WPM status widget"
    depends on !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL
    select LV_USE_FLEX
    select LV_USE_IMAGE
    select LV_USE_LABEL
    select ZMK_WPM
